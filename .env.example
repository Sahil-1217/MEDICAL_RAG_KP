# =====================================================================
# MEDICAL RESEARCH ASSISTANT - ENVIRONMENT CONFIGURATION
# =====================================================================

# OpenAI API Key (Required for text-embedding-3-small and LLM Generation)
OPENAI_API_KEY=your_openai_api_key_here

# NCBI / PubMed API Settings (Biopython Entrez)
# NCBI requires a valid contact email for API usage tracking
NCBI_EMAIL=researcher@example.com
# Optional NCBI API Key for higher rate limits (10 requests/sec vs 3/sec)
NCBI_API_KEY=

# Vector Database Persistence Paths (Relative or Absolute)
CHROMA_PERSIST_DIR=./data/processed/chroma_db
FAISS_INDEX_DIR=./data/processed/faiss_index

# Default Model Configuration
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_LLM_MODEL=gpt-4o-mini
NLI_VERIFIER_MODEL=cross-encoder/nli-deberta-v3-small
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
